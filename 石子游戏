class Solution {
public:
    bool stoneGame(vector<int>& piles) {
        sort(piles.begin(),piles.end());
        int x=0,y=0;
        int flag=0;
        for(int i=piles.size()-1;i>=0;i--)
        {
            if(flag%2==0)
            {
                x+=piles[i];
            }
            else y+=piles[i];
        }
        return x>y;
    }
};