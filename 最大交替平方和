class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        for(int i=0;i<nums.size();i++)
        {
            nums[i]=abs(nums[i]);
        }
        sort(nums.begin(),nums.end());
        long long sum=0;
        if(nums.size()%2==0)
        {
            int left=0,right=nums.size()-1;
            while(left<right)
            {
                sum+=1LL*nums[right]*nums[right--];
                sum-=1LL*nums[left]*nums[left++];
            }
        }
        else
        {
            int left=0,right=nums.size()-1;
            sum+=1LL*nums[right]*nums[right--];
            while(left<right)
            {
                sum+=1LL*nums[right]*nums[right--];
                sum-=1LL*nums[left]*nums[left++];
            }
        }
        return sum;
    }
};