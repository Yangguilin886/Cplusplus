class Solution {
public:
    int uniquePaths(vector<vector<int>>& grid) {
        int n=grid.size(),m=grid[0].size();
        int mod=1'000'000'007;
        vector<vector<vector<int>>> ret(n,vector<vector<int>>(m,vector<int>(2,-1)));
        auto dfs=[&](this auto&& dfs,int i,int j,int k)
        {
            if(i<0||j<0)return 0;
            if(i==0&&j==0)return 1;
            int& sum=ret[i][j][k];
            if(sum!=-1)return sum;
            if(grid[i][j]==0)sum=(dfs(i-1,j,0)+dfs(i,j-1,1))%mod;
            else if(k==0)
            {
                sum=dfs(i,j-1,1);
            }
            else if(k==1)
            {
                sum=dfs(i-1,j,0);
            }
            return sum;
        };
        dfs(n-1,m-1,0);
        return ret[n-1][m-1][0];
    }
};