class Solution {
public:
    int minSetSize(vector<int>& arr) {
        unordered_map<int,int> hs;
        for(int i=0;i<arr.size();i++)
        {
            hs[arr[i]]++;
        }
        vector<int> ret;
        for(int i=0;i<arr.size();i++)
        {
            if(hs.count(arr[i]))
            {
                ret.push_back(hs[arr[i]]);
                hs.erase(arr[i]);
            }
        }
        sort(ret.begin(),ret.end());
        int n=arr.size();
        int flag=0;
        int m=0;
        for(int i=ret.size()-1;i>=0;i--)
        {
            m+=ret[i];
            flag++;
            if(m>=n/2)return flag;
        }
        return flag;
    }
};