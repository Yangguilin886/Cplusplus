class Solution {
public:
    string removeOuterParentheses(string s) {
        string tmp;
        stack<char> qs;
        for(int i=0;i<s.size();i++)
        {
            if(s[i]=='(')
            {
                if(!qs.empty())
                {
                    tmp+='(';
                }
                qs.push(s[i]);
            }
            else
            {
                qs.pop();
                if(!qs.empty())
                {
                    tmp+=")";
                }
            }
        }
        return tmp;
    }
};