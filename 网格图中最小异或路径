class Solution {
public:
    int minCost(vector<vector<int>>& grid) {
        int n=grid.size(),m=grid[0].size();
        int sum=0;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                sum|=grid[i][j];
            }
        }
        vector<vector<vector<bool>>> ret(n,vector<vector<bool>>(m,vector<bool>(sum+1)));
        int ans=INT_MAX;
        auto dfs=[&](this auto&& dfs,int x,int y,int tmp)
        {
            if(x<0||y<0||ans==0||ret[x][y][tmp])return;
            ret[x][y][tmp]=true;
            tmp^=grid[x][y];
            if(x==0&&y==0)
            {
                ans=min(ans,tmp);
            }
            dfs(x-1,y,tmp);
            dfs(x,y-1,tmp);
        };
        dfs(n-1,m-1,0);
        return ans;
    }
};