class Solution {
public:
    vector<int> remainingMethods(int n, int k, vector<vector<int>>& nums) {
        vector<vector<int>> ret(n);
        for(auto x:nums)
        {
            ret[x[0]].push_back(x[1]);
        }
        vector<bool> dp(n);
        auto dfs=[&](auto&& dfs,int x)->void
        {
            dp[x]=true;
            for(auto e:ret[x])
            {
                if(!dp[e])
                {
                    dfs(dfs,e);
                }
            }
        };
        dfs(dfs,k);
        for(auto x:nums)
        {
            if(!dp[x[0]]&&dp[x[1]])
            {
                vector<int> tmp(n);
                for(int i=0;i<n;i++)tmp[i]=i;
                return tmp;
            }
        }
        vector<int> tmp;
        for(int i=0;i<n;i++)
        {
            if(!dp[i])tmp.push_back(i);
        }
        return tmp;
    }
};