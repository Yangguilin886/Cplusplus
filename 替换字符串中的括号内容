class Solution {
public:
    string evaluate(string s, vector<vector<string>>& knowledge) {
        unordered_map<string,vector<string>> hs;
        for(int i=0;i<knowledge.size();i++)
        {
            hs[knowledge[i][0]].push_back(knowledge[i][1]);
        }
        int i=0;
        string tmp;
        while(i<s.size())
        {
            if(s[i]=='(')
            {
                i++;
                string sum;
                while(s[i]!=')')
                {
                    sum+=s[i];
                    i++;
                }
                i++;
                if(hs.count(sum))
                {
                    tmp+=hs[sum][0];
                }
                else{
                    tmp+='?';
                }
            }
            else
            {
                tmp+=s[i++];
            }
        }
        return tmp;
    }
};