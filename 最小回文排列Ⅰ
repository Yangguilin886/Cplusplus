class Solution {
public:
    string smallestPalindrome(string s) {
        vector<int> dp(26);
        for(int i=0;i<s.size();i++)
        {
            dp[s[i]-'a']++;
        }
        string tmp;
        for(int i=0;i<26;i++)
        {
            for(int j=0;j<dp[i]/2;j++)
            {
                tmp+='a'+i;
            }
        }
        for(int i=0;i<26;i++)
        {
            if(dp[i]%2)
            {
                tmp+='a'+i;
            }
        }
        for(int i=25;i>=0;i--)
        {
            for(int j=0;j<dp[i]/2;j++)
            {
                tmp+='a'+i;
            }
        }
        return tmp;
    }
};